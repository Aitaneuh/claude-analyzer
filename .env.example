# ---- Claude Analyzer configuration ----

# Folder containing Claude Code session logs (normally ~/.claude/projects).
# In Docker this is the path INSIDE the container where you mount that folder.
# Leave empty if you only push data with scripts/sync.mjs.
CLAUDE_PROJECTS_DIR=/claude/projects

# How often (seconds) the server rescans CLAUDE_PROJECTS_DIR. 0 disables periodic scans.
SCAN_INTERVAL_SECONDS=300

# Where the SQLite database lives (mount a volume here in Docker).
DATA_DIR=/data

# Shared secret for POST /api/ingest (used by scripts/sync.mjs from your PC).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_TOKEN=

# Optional: protect the dashboard with HTTP basic auth (username is "admin" unless set).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Optional: Anthropic Admin API key (sk-ant-admin...) to show your Console org's
# real API usage & cost from the Usage and Cost Analytics API.
ANTHROPIC_ADMIN_KEY=

# Timezone used to bucket days/hours on charts (e.g. Europe/Paris, America/New_York).
TZ=UTC

# Optional: path to a custom pricing JSON (copy pricing.json and edit).
PRICING_FILE=
